# ---------------------------------------------------------------------------
# SignalForge configuration
# Copy to .env and fill in.  NEVER commit .env to git.
# ---------------------------------------------------------------------------

# PAPER = simulated orders (real prices).  LIVE = real MEXC spot orders.
# Default is always PAPER.
TRADING_MODE=PAPER

# --- Telegram user account (reads the signal channels) ---------------------
# Get api_id / api_hash from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_from_my_telegram_org
# StringSession produced by:  python scripts/login.py
TELEGRAM_SESSION=

# Channels to listen to (comma separated: @username, t.me link or -100... id)
TELEGRAM_CHANNELS=@channel1,@channel2

# --- MEXC Spot API ---------------------------------------------------------
# Permissions needed: SPOT_DEAL_READ / SPOT_DEAL_WRITE / SPOT_ACCOUNT_READ
# WITHDRAWAL MUST BE OFF.
MEXC_API_KEY=
MEXC_API_SECRET=

# --- Notifications (your own bot, talks to you) ----------------------------
TELEGRAM_ADMIN_BOT_TOKEN=123456789:token-from-BotFather
TELEGRAM_ADMIN_CHAT_ID=your_numeric_chat_id

# --- Halal whitelist -------------------------------------------------------
# Only these symbols are ever traded.  Set by the admin, never by the bot.
HALAL_COINS=BTCUSDT,ETHUSDT,SOLUSDT

# --- Risk ------------------------------------------------------------------
TRADE_AMOUNT_USDT=100
MAX_OPEN_TRADES=3

# Circuit breakers - each one only blocks NEW buys; open positions are still
# closed at TP / SL.  0 = off.
# Realised loss over the current UTC day at which buying stops until midnight.
MAX_DAILY_LOSS_USDT=0
# Losing trades in a row at which buying pauses until you send /resume.
MAX_CONSECUTIVE_LOSSES=0
# A buy waits while (ask - bid) / mid is wider than this (percent).  An
# illiquid book costs the spread twice and a LIMIT order in it rarely fills.
MAX_ENTRY_SPREAD_PERCENT=1
# A position stuck between SL and TP for this long is reported once (warn)
# or sold at market (close), so it stops occupying a slot.  0 = off.
MAX_HOLD_HOURS=0
MAX_HOLD_ACTION=warn

# --- Follow-up posts and the second reader ---------------------------------
# "50% yopamiz", "stop to entry", "bekor" posts are tied to the position and
# wait for your button (UPDATE_CONFIRMATION=false acts at once).
CHANNEL_UPDATES=true
UPDATE_CONFIRMATION=true
# A post the parser cannot read is handed to Claude; needs `pip install
# anthropic` and a key from console.anthropic.com.  The reading waits for
# your Confirm button unless LLM_SIGNAL_CONFIRMATION=false.
LLM_FALLBACK=true
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_SIGNAL_CONFIRMATION=true

# --- Signal / order handling ----------------------------------------------
SIGNAL_EXPIRY_MINUTES=15
ORDER_TIMEOUT_SECONDS=60
USE_MARKET_ORDER=false

# Many channels post a setup without ever writing LONG/BUY.  With false the
# side is read from the numbers themselves (SL under the entry and TP above it
# can only be a buy).  Set true to trade only signals that name the direction.
REQUIRE_EXPLICIT_DIRECTION=false

# A signal whose entry sits BELOW the live price ("kelsa" - buy when it comes
# down) is a resting limit order.  wait = keep it for LIMIT_ENTRY_EXPIRY_HOURS
# and buy when the price touches the entry.  skip = treat it as a missed move.
ENTRY_ABOVE_ZONE=wait
LIMIT_ENTRY_EXPIRY_HOURS=24

# A single-price entry ("Kirish: 120", a chart level) is treated as a small
# zone, up to this much above the level - the admins' own "0.2-0.3%" rule.
ENTRY_TOLERANCE_PERCENT=0.3

# After TP1 the stop is moved up to the entry price, so the rest of the
# position cannot lose ("1 TP olsa stopni olgan joyga ko'tarasiz").
MOVE_SL_TO_ENTRY_AFTER_TP1=true

# In a discussion group (members can post) only the admins are a signal
# source: posts made as the group and posts by admin accounts.  Members'
# screenshots are ignored.  Broadcast channels are unaffected.
GROUP_ADMIN_ONLY=true

# Chart screenshots: read entry/TP/SL off the picture (OCR + colour).
READ_CHART_IMAGES=true
# An image-derived signal is only traded after you press Confirm in Telegram.
IMAGE_SIGNAL_CONFIRMATION=true
# Drop a reading whose entry is further than this from the live price -
# a misread digit lands an order of magnitude away and is caught here.
IMAGE_MAX_PRICE_DEVIATION_PERCENT=20

# How far past the last price a LIMIT order is placed so it fills (percent).
LIMIT_SLIPPAGE_PERCENT=0.1

# Position split over TP1/TP2/TP3 (percent, must sum to 100).
# With fewer TPs in the signal the ratios are re-normalised automatically.
TP_SPLITS=30,30,40

# rest: poll /ticker/price every PRICE_POLL_SECONDS.  websocket: read the
# exchange's pushed top-of-book (needs `pip install websockets`); a coin
# without a push for PRICE_FEED_MAX_AGE_SECONDS falls back to REST.
PRICE_FEED=rest
PRICE_FEED_MAX_AGE_SECONDS=10
# How often prices are polled for entry / TP / SL checks (seconds)
PRICE_POLL_SECONDS=5

# Fee applied to PAPER fills so simulated PNL is realistic (0.0005 = 0.05%)
PAPER_FEE_RATE=0.0005

# --- Infrastructure --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://signalforge:signalforge@localhost:5432/signalforge
LOG_LEVEL=INFO

# --- Keeping it alive --------------------------------------------------------
# Dead man's switch: pinged after every good price-loop pass.  The stop-loss
# only exists while the bot runs - a monitor that misses the ping is your alarm
# (healthchecks.io, Uptime Kuma, cronitor ...).
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SECONDS=60
# On (re)start read back the last SIGNAL_EXPIRY_MINUTES of every channel.
CATCH_UP_ON_START=true
# Channel posts older than this are deleted hourly (signals / trades stay).
MESSAGE_RETENTION_DAYS=90
